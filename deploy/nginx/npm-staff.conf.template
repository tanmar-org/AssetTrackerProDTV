# Paste the rendered file in this host's Advanced tab, with NO Custom Locations.
# Own the complete location: server-only proxy_set_header settings would be lost
# when NPM's generated location declares its own headers. Force SSL in the UI.
client_max_body_size 17m;
client_body_timeout 15s;
send_timeout 30s;
# NPM's default access log includes full query strings; avoid label metadata.
access_log off;

# Server-to-server asset lookup never enters through the public staff host.
location ~* ^/api/service-assets(?:/|$) { return 404; }

location / {
    proxy_pass https://$server:$port;
    proxy_ssl_server_name on;
    proxy_ssl_name @@STAFF_HOST@@;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate @@NPM_CA@@;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host @@STAFF_HOST@@;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $realip_remote_addr;
    proxy_set_header X-Real-IP $realip_remote_addr;
    # Original TCP peer avoids NPM's broad inherited real-IP header trust.
    # This direct-edge policy counts CDN/proxy peers if another hop precedes NPM.
    proxy_set_header X-Login-Client-IP $realip_remote_addr;
    proxy_set_header X-Login-Proxy-Secret "@@LOGIN_SECRET@@";
    proxy_set_header X-Request-Client-IP "";
    proxy_set_header X-Request-Proxy-Secret "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
    # Writes must not be replayed, and private responses must not enter a cache.
    proxy_next_upstream off;
    proxy_cache off;
}
