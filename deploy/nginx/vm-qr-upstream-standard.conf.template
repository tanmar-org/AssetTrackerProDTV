# Standard proxy mode injects the QR app's credential only after the gateway
# has verified the original TCP peer. Discard all caller-supplied private fields.
proxy_pass http://@@QR_UPSTREAM@@:@@QR_PORT@@;
proxy_set_header Host @@QR_HOST@@;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Request-Client-IP $remote_addr;
proxy_set_header X-Request-Proxy-Secret "@@REQUEST_SECRET@@";
proxy_set_header X-Login-Client-IP "";
proxy_set_header X-Login-Proxy-Secret "";
proxy_set_header X-Forwarded-For "";
proxy_set_header X-Real-IP "";
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_connect_timeout 5s;
proxy_read_timeout 30s;
proxy_send_timeout 30s;
proxy_next_upstream off;
proxy_cache off;
