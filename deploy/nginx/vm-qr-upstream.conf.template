# Backend Node receives only the authenticated NPM client identity fields.
proxy_pass http://@@QR_UPSTREAM@@:@@QR_PORT@@;
proxy_set_header Host @@QR_HOST@@;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Request-Client-IP $http_x_request_client_ip;
proxy_set_header X-Request-Proxy-Secret $http_x_request_proxy_secret;
proxy_set_header X-Login-Client-IP "";
proxy_set_header X-Login-Proxy-Secret "";
proxy_set_header X-Forwarded-For "";
proxy_set_header X-Real-IP "";
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_connect_timeout 5s;
proxy_read_timeout 30s;
proxy_send_timeout 30s;
proxy_next_upstream off;
proxy_cache off;
