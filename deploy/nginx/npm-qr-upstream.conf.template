# Mount this rendered protected file at NPM_QR_UPSTREAM inside the NPM container.
# All three public locations share the identical authenticated header/TLS policy.
proxy_pass https://$server:$port;
proxy_ssl_server_name on;
proxy_ssl_name @@QR_HOST@@;
proxy_ssl_verify on;
proxy_ssl_verify_depth 3;
proxy_ssl_trusted_certificate @@NPM_CA@@;
proxy_http_version 1.1;
proxy_set_header Connection "";
proxy_set_header Host @@QR_HOST@@;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-For $realip_remote_addr;
proxy_set_header X-Real-IP $realip_remote_addr;
# Original peer remains trustworthy even if inherited real-IP rules rewrite IP.
proxy_set_header X-Request-Client-IP $realip_remote_addr;
proxy_set_header X-Request-Proxy-Secret "@@REQUEST_SECRET@@";
proxy_set_header X-Login-Client-IP "";
proxy_set_header X-Login-Proxy-Secret "";
proxy_connect_timeout 5s;
proxy_read_timeout 30s;
proxy_send_timeout 30s;
proxy_next_upstream off;
proxy_cache off;
