# Copy to .env.local; never commit real credentials.
# Use a separate PostgreSQL database and restricted runtime role for each app.
DATABASE_URL=
ADMIN_SHARED_SECRET=
SERVICE_REQUEST_API_URL=http://127.0.0.1:5174/api/requests
# Internet ingress: use a new 32–128 character URL-safe secret. Proxy must strip
# client values and overwrite x-login-proxy-secret and x-login-client-ip.
# Blank is for local development: only global/username login limits are available.
LOGIN_PROXY_SECRET=

# Internet staff sign-in: select ad explicitly after migration and reviewed links.
# Blank with no AD settings retains local PIN development; partial settings fail.
AUTH_MODE=
# Stable unique namespace for this directory; don't reuse it for another forest.
AD_DIRECTORY_ID=
# Private LDAPS server DNS name/port, no credentials/path/query or plaintext LDAP.
AD_LDAP_URL=
AD_BASE_DN=
AD_BIND_DN=
# Restricted directory reader only; never use a Domain Admin credential.
AD_BIND_PASSWORD=
# Absolute path to the approved CA certificate/bundle. TLS verification is mandatory.
AD_CA_FILE=
