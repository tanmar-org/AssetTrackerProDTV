{
  "name": "directv-asset-tracker-eric",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci --no-audit --no-fund",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 5173",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 5173",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "node scripts/verify-vendors.mjs && eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "db:migrate": "node --env-file-if-exists=.env.migrate scripts/migrate-database.mjs tracker",
    "db:backup": "node scripts/backup-databases.mjs",
    "db:restore": "node scripts/restore-databases.mjs",
    "service:reconcile": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/reconcile-service-operations.mjs",
    "admin:provision": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/provision-admin.mjs",
    "test:integration": "node --experimental-strip-types --test tests/integration/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "vendor:verify": "node scripts/verify-vendors.mjs",
    "auth:link-ad": "node --env-file-if-exists=.env.migrate --experimental-strip-types scripts/link-ad-identity.mjs",
    "ingress:prepare": "node scripts/prepare-ingress.mjs",
    "test:ingress": "node --test tests/ingress/*.test.mjs",
    "test:services": "node --test tests/services/*.test.mjs",
    "db:prepare": "node scripts/prepare-databases.mjs"
  },
  "dependencies": {
    "@tanmar/database": "file:packages/database",
    "ldapts": "9.2.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Asset Tracker Pro"
}
