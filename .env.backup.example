# Copy outside the repository, protect with mode 0600, and use --env-file.
# Passwords belong in the protected libpq passfile, never in shell arguments.
PGSERVICEFILE=/etc/assettracker/backup/pg_service.conf
PGPASSFILE=/etc/assettracker/backup/pgpass
TRACKER_BACKUP_SERVICE=tracker_backup
REQUESTS_BACKUP_SERVICE=requests_backup
BACKUP_DIRECTORY=/var/lib/assettracker-backups
BACKUP_TIMEOUT_SECONDS=600
