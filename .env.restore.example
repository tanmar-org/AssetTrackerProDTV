# Recovery services must point to new, empty assettracker_restore_* databases,
# owned by their operator connection. Runtime roles must also use that prefix.
PGSERVICEFILE=/etc/assettracker/recovery/pg_service.conf
PGPASSFILE=/etc/assettracker/recovery/pgpass
TRACKER_RESTORE_SERVICE=tracker_restore
REQUESTS_RESTORE_SERVICE=requests_restore
TRACKER_RESTORE_RUNTIME_ROLE=assettracker_restore_tracker_runtime
REQUESTS_RESTORE_RUNTIME_ROLE=assettracker_restore_requests_runtime
BACKUP_SET_DIRECTORY=/var/lib/assettracker-backups/REPLACE_WITH_PUBLISHED_SET
BACKUP_TIMEOUT_SECONDS=600
