# Copy to .env.local; never commit real credentials.
# Use a separate PostgreSQL database and restricted runtime role for each app.
DATABASE_URL=
ADMIN_SHARED_SECRET=
# QR-to-tracker lookup is server-only; do not point this at a public browser URL.
TRACKER_ASSET_API_URL=http://127.0.0.1:5173/api/service-assets
# Recommended for production ingress: proxy must overwrite both x-request-* headers.
# When set, public requests require this secret and one validated client IP.
REQUEST_PROXY_SECRET=
